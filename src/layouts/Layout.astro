---
// src/layouts/Layout.astro
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Diego Arriagada — Profesional en Operaciones, Logística y Control de Gestión. Experiencia en liderazgo de equipos y formación en Análisis de Datos (SAP, Power BI, SQL)." />
    <title>Diego Arriagada | Operaciones & Control de Gestión</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <style is:global>
      /* ============ VARIABLES (Tema Día/Noche) ============ */
      :root {
        --bg: #f8fafc;
        --bg-soft: #ffffff;
        --text: #0f172a;
        --text-muted: #475569;
        --accent: #1d4ed8;
        --accent-dark: #1e3a8a;
        --accent-light: #eff6ff;
        --border: #e2e8f0;
        --shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
      }

      [data-theme="dark"] {
        --bg: #0f172a;
        --bg-soft: #1e293b;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --accent: #3b82f6;
        --accent-dark: #1d4ed8;
        --accent-light: rgba(59, 130, 246, 0.15);
        --border: #334155;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      /* ============ RESET & BASE ============ */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 80px; }
      body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        transition: background 0.3s, color 0.3s;
      }
      h1, h2, h3, h4 { font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1.2; letter-spacing: -0.02em; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      ul { list-style: none; }

      /* ============ LAYOUT ============ */
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
      .section { padding: 5rem 0; }
      .section-title { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 0.5rem; color: var(--text); }
      .section-subtitle { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 3rem; max-width: 600px; }
      .badge {
        display: inline-block; padding: 0.4rem 0.8rem; border-radius: 6px;
        background: var(--accent-light); color: var(--accent);
        font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.05em; margin-bottom: 1rem;
      }

      /* ============ NAVBAR ============ */
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        padding: 1.2rem 0; background: var(--bg-soft);
        border-bottom: 1px solid var(--border); transition: all 0.3s;
      }
      nav.scrolled { padding: 0.8rem 0; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; }
      .logo {
        font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.3rem; font-weight: 800;
        display: flex; align-items: center; gap: 0.6rem; color: var(--text);
      }
      .logo-mark {
        width: 36px; height: 36px; background: var(--accent); border-radius: 8px;
        display: grid; place-items: center; color: white; font-size: 1rem;
      }
      .nav-links { display: flex; gap: 2rem; align-items: center; }
      .nav-links a { font-size: 0.9rem; color: var(--text-muted); font-weight: 600; transition: color 0.2s; }
      .nav-links a:hover { color: var(--accent); }
      
      /* Adiciones Navbar (Próximamente) */
      .nav-item-upcoming {
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: default;
      }
      .nav-badge-upcoming {
        font-size: 0.65rem;
        background: var(--accent-light);
        color: var(--accent);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .nav-actions { display: flex; gap: 1rem; align-items: center; }
      .theme-btn {
        background: transparent; border: 1px solid var(--border); color: var(--text);
        width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
        display: grid; place-items: center; font-size: 1.2rem; transition: all 0.2s;
      }
      .theme-btn:hover { border-color: var(--accent); color: var(--accent); }
      .menu-btn { display: none; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text); }
      .nav-cta {
        padding: 0.6rem 1.2rem; border-radius: 8px; background: var(--accent);
        color: white; font-size: 0.9rem; font-weight: 600; transition: background 0.2s;
      }
      .nav-cta:hover { background: var(--accent-dark); }

      /* ============ HERO ============ */
      .hero { padding: 9rem 0 5rem; background: var(--bg-soft); border-bottom: 1px solid var(--border); }
      .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: center; }
      .hero h1 { font-size: clamp(2.5rem, 5vw, 3.8rem); margin-bottom: 0.5rem; color: var(--text); }
      .hero .role { font-size: 1.2rem; color: var(--accent); font-weight: 600; margin-bottom: 1.5rem; }
      .hero p.tagline { color: var(--text-muted); font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem; }
      .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
      
      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.8rem;
        border-radius: 8px; font-weight: 600; font-size: 0.95rem; cursor: pointer;
        border: none; transition: all 0.2s; font-family: inherit;
      }
      .btn-primary { background: var(--accent); color: white; box-shadow: 0 4px 15px rgba(29, 78, 216, 0.3); }
      .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); }
      .btn-secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
      .btn-secondary:hover { background: var(--accent-light); border-color: var(--accent); color: var(--accent); }

      .hero-metrics { display: flex; gap: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); flex-wrap: wrap; }
      .metric-value { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800; color: var(--accent); line-height: 1; margin-bottom: 0.3rem; }
      .metric-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }

      .hero-photo { position: relative; justify-self: center; max-width: 380px; width: 100%; }
      .photo-frame { position: relative; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); border: 4px solid var(--bg); }
      .photo-frame img { width: 100%; height: auto; object-fit: cover; aspect-ratio: 3/4; filter: grayscale(100%); transition: filter 0.3s; }
      .photo-frame:hover img { filter: grayscale(0%); }
      
      .photo-badge {
        position: absolute; bottom: 20px; left: 20px; right: 20px;
        background: var(--bg-soft);
        backdrop-filter: blur(10px); padding: 1rem; border-radius: 12px;
        text-align: center; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      }
      .photo-badge strong { display: block; font-size: 0.95rem; color: var(--text); }
      .photo-badge span { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; display: block; margin-top: 2px; }

      /* ============ ABOUT ============ */
      .about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; }
      .card { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 16px; padding: 2.5rem; box-shadow: var(--shadow); }
      .bio p { color: var(--text-muted); margin-bottom: 1rem; font-size: 1.05rem; line-height: 1.7; }
      .bio p:last-child { margin-bottom: 0; }
      .bio strong { color: var(--text); }
      .contact-info { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
      .contact-info a { display: flex; align-items: center; gap: 0.8rem; font-size: 0.95rem; color: var(--text-muted); transition: color 0.2s; font-weight: 500; }
      .contact-info a:hover { color: var(--accent); }
      .contact-info svg { color: var(--accent); }
      .soft-skills h3 { font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--text); }
      .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
      .chip { padding: 0.5rem 1rem; border-radius: 8px; background: var(--accent-light); color: var(--accent); font-size: 0.85rem; font-weight: 600; }

      /* ============ SKILLS ============ */
      .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
      .skill-card { 
        background: var(--bg-soft); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; 
        transition: all 0.3s ease; box-shadow: var(--shadow); 
      }
      .skill-card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 15px 30px rgba(29, 78, 216, 0.15); }
      .skill-icon { 
        width: 50px; height: 50px; background: var(--accent-light); color: var(--accent); 
        border-radius: 12px; display: grid; place-items: center; font-size: 1.5rem; margin-bottom: 1.5rem; 
      }
      .skill-card h4 { font-size: 1.15rem; margin-bottom: 0.8rem; color: var(--text); }
      .skill-card p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }
      
      .tech-extra { background: var(--bg-soft); border: 1px dashed var(--border); border-radius: 16px; padding: 2.5rem 2rem; margin-top: 3rem; }
      .tech-extra h4 { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 1rem; color: var(--text); font-size: 1.2rem; }
      .tech-extra p { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.5rem; text-align: center; max-width: 700px; margin-left: auto; margin-right: auto; }
      .tech-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
      
      .tech-chip { 
        font-size: 0.8rem; padding: 0.45rem 1rem; border-radius: 9999px; background: var(--accent-light); 
        border: 1px solid var(--accent); color: var(--accent); font-weight: 600; transition: all 0.2s ease;
      }
      [data-theme="dark"] .tech-chip { color: #60a5fa; border-color: #60a5fa; background: rgba(96, 165, 250, 0.15); }
      .tech-chip:hover { background: var(--accent); color: white; border-color: var(--accent); transform: translateY(-2px); }
      [data-theme="dark"] .tech-chip:hover { background: #3b82f6; }

      .tech-chip.highlight { background: #f3e8ff; color: #6b21a8; border-color: #a855f7; font-weight: 700; }
      [data-theme="dark"] .tech-chip.highlight { background: rgba(168, 85, 247, 0.2); color: #d8b4fe; border-color: #a855f7; }
      .tech-chip.highlight:hover { background: #a855f7; color: white; border-color: #a855f7; transform: translateY(-2px); }

      /* ============ PROJECTS ============ */
      .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
      .project-card {
        background: var(--bg-soft); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;
        transition: all 0.3s ease; box-shadow: var(--shadow); display: flex; flex-direction: column;
      }
      .project-card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 15px 30px rgba(29, 78, 216, 0.15); }
      .project-icon { width: 50px; height: 50px; background: var(--accent-light); color: var(--accent); border-radius: 12px; display: grid; place-items: center; margin-bottom: 1.5rem; }
      .project-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 0.8rem; }
      .project-desc { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1; }
      .project-tools { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
      .project-tool-tag { font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px; background: var(--bg); border: 1px solid var(--border); color: var(--text-muted); font-weight: 600; }
      .project-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--accent); font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: gap 0.2s ease; }
      .project-link:hover { gap: 0.8rem; text-decoration: underline; }

      /* ============ EXPERIENCE ============ */
      .timeline { position: relative; padding-left: 2rem; }
      .timeline::before { content: ''; position: absolute; left: 6px; top: 10px; bottom: 10px; width: 2px; background: var(--border); }
      .exp-item { position: relative; margin-bottom: 2.5rem; }
      .exp-item::before {
        content: ''; position: absolute; left: -2rem; top: 1.5rem;
        width: 14px; height: 14px; border-radius: 50%;
        background: var(--bg-soft); border: 3px solid var(--accent);
      }
      .exp-card { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 16px; padding: 1.8rem; box-shadow: var(--shadow); transition: border-color 0.2s; }
      .exp-card:hover { border-color: var(--accent); }
      .exp-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
      .exp-role { font-size: 1.15rem; font-weight: 700; color: var(--text); }
      .exp-period { font-size: 0.8rem; color: var(--accent); font-weight: 700; background: var(--accent-light); padding: 0.3rem 0.8rem; border-radius: 6px; white-space: nowrap; }
      .exp-company { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1rem; font-weight: 600; }
      .exp-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.2rem; }
      .exp-desc ul { padding-left: 1.2rem; list-style: disc; }
      .exp-desc li { margin-bottom: 0.5rem; }
      .exp-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .exp-tag { font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px; background: var(--bg); border: 1px solid var(--border); color: var(--text-muted); font-weight: 600; }
      
      /* Adiciones Experience (Botón y Título de sección expandible) */
      .exp-actions { text-align: center; margin-top: 2rem; }
      .exp-section-title {
        text-align: center; margin: 2.5rem 0 1.5rem; color: var(--text);
        font-size: 1.2rem; font-weight: 700; border-top: 1px solid var(--border); padding-top: 1.5rem;
      }

      /* ============ EDUCACIÓN ============ */
      .edu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
      .edu-card { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; box-shadow: var(--shadow); }
      .edu-card h4 { font-size: 1.05rem; margin-bottom: 0.5rem; color: var(--text); }
      .edu-inst { font-size: 0.9rem; color: var(--accent); font-weight: 600; margin-bottom: 0.8rem; }
      .edu-card p { font-size: 0.9rem; color: var(--text-muted); }

      /* ============ CONTACTO ============ */
      .contact-section { background: var(--accent); color: white; border-radius: 24px; padding: 4rem 2rem; text-align: center; margin-bottom: 4rem; }
      .contact-section h2 { font-size: 2.2rem; margin-bottom: 1rem; color: white; }
      .contact-section p { font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem; opacity: 0.9; }
      .contact-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
      .btn-white { background: white; color: var(--accent); }
      .btn-white:hover { background: #f1f5f9; transform: translateY(-2px); }
      .btn-outline { background: transparent; color: white; border: 1px solid rgba(255, 255, 255, 0.5); }
      .btn-outline:hover { background: rgba(255, 255, 255, 0.1); border-color: white; }
      
      /* Adiciones Contacto (Links directos) */
      .contact-direct { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.2); }
      .contact-direct > p { font-size: 0.95rem; color: rgba(255, 255, 255, 0.9); margin-bottom: 0.8rem; }
      .contact-links { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
      .contact-link {
        color: white; text-decoration: none; font-weight: 600; display: flex;
        align-items: center; gap: 0.4rem; font-size: 1.05rem; transition: opacity 0.2s ease;
      }
      .contact-link:hover { opacity: 0.8; text-decoration: underline; }

      /* ============ FOOTER ============ */
      .footer-main { background: var(--bg-soft); border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 3rem; }
      .footer-content { text-align: center; }
      .footer-links { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
      .footer-link { color: var(--text); text-decoration: none; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s; }
      .footer-link:hover { color: var(--accent); }
      .footer-copyright { font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--text); }
      .footer-disclaimer { font-size: 0.75rem; color: var(--text-muted); opacity: 0.8; max-width: 600px; margin: 0 auto; line-height: 1.4; }

      /* ============ WHATSAPP FLOAT BUTTON ============ */
      .whatsapp-float {
        position: fixed; bottom: 2rem; right: 2rem; width: 60px; height: 60px;
        background-color: #25D366; color: white; border-radius: 50%;
        display: grid; place-items: center; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
        z-index: 9999; transition: all 0.3s ease; text-decoration: none;
      }
      .whatsapp-float:hover { transform: scale(1.1) translateY(-3px); box-shadow: 0 8px 25px rgba(37, 211, 102, 0.6); background-color: #1ebc57; }
      @media (max-width: 768px) {
        .whatsapp-float { width: 55px; height: 55px; bottom: 1.5rem; right: 1.5rem; }
      }

      /* ============ SERVICES ============ */
      .services-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto;
      }
      .service-card {
        background: var(--bg-soft); border: 2px solid var(--accent); border-radius: 16px; padding: 2.5rem;
        transition: all 0.3s ease; box-shadow: var(--shadow); display: flex; flex-direction: column; text-align: center;
      }
      .service-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(29, 78, 216, 0.2); }
      .service-icon { width: 60px; height: 60px; background: var(--accent); color: white; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 1.5rem; }
      .service-title { font-size: 1.3rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; }
      .service-desc { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.5rem; }
      .service-features { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 2rem; text-align: left; }
      .feature-tag { font-size: 0.9rem; color: var(--text); font-weight: 500; }
      .service-cta {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
        background: #25D366; color: white; font-weight: 700; font-size: 1rem; padding: 0.9rem 1.5rem;
        border-radius: 8px; text-decoration: none; transition: all 0.2s ease;
      }
      .service-cta:hover { background: #1ebc57; transform: scale(1.02); }

      /* ============ RESPONSIVE ============ */
      @media (max-width: 900px) {
        .hero-grid, .about-grid { grid-template-columns: 1fr; gap: 3rem; }
        .hero-photo { max-width: 320px; order: -1; }
        .nav-links {
          position: absolute; top: 100%; left: 0; right: 0; flex-direction: column;
          background: var(--bg-soft); padding: 2rem; border-bottom: 1px solid var(--border);
          clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); transition: clip-path 0.3s;
        }
        .nav-links.open { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
        .menu-btn { display: block; }
        .nav-cta { display: none; }
      }
    </style>

    <!-- Script para prevenir el parpadeo (FOUC) al cargar la página -->
    <script is:inline>
      const temaGuardado = localStorage.getItem('theme');
      const prefiereOscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const temaInicial = temaGuardado || (prefiereOscuro ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', temaInicial);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>