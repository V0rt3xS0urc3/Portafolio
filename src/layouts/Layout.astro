---
// src/layouts/Layout.astro
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Diego Arriagada — Jefe de Operaciones Logísticas y Administrativas." />
    <title>Diego Arriagada | Operaciones & Logística</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- AQUÍ VA TODO TU CSS -->
    <style is:global>
       /* ============ VARIABLES (Tema Día/Noche) ============ */
    :root {
      /* Tema Claro (Por defecto) */
      --bg: #f8fafc;
      --bg-soft: #ffffff;
      --text: #0f172a;
      --text-muted: #475569;
      --accent: #1d4ed8;
      --accent-dark: #1e3a8a;
      --accent-light: #eff6ff;
      --border: #e2e8f0;
      --shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    [data-theme="dark"] {
      /* Tema Oscuro */
      --bg: #0f172a;
      --bg-soft: #1e293b;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #3b82f6;
      --accent-dark: #1d4ed8;
      --accent-light: rgba(59, 130, 246, 0.15);
      --border: #334155;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* ============ RESET & BASE ============ */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      transition: background 0.3s, color 0.3s;
    }

    h1, h2, h3, h4 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    ul {
      list-style: none;
    }

    /* ============ LAYOUT ============ */
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section {
      padding: 5rem 0;
    }

    .section-title {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-bottom: 3rem;
      max-width: 600px;
    }

    .badge {
      display: inline-block;
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }

    /* ============ NAVBAR ============ */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1.2rem 0;
      background: var(--bg-soft);
      border-bottom: 1px solid var(--border);
      transition: all 0.3s;
    }

    nav.scrolled {
      padding: 0.8rem 0;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text);
    }

    .logo-mark {
      width: 36px;
      height: 36px;
      background: var(--accent);
      border-radius: 8px;
      display: grid;
      place-items: center;
      color: white;
      font-size: 1rem;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 600;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .theme-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      transition: all 0.2s;
    }

    .theme-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--text);
    }

    .nav-cta {
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      background: var(--accent);
      color: white;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.2s;
    }

    .nav-cta:hover {
      background: var(--accent-dark);
    }

    /* ============ HERO ============ */
    .hero {
      padding: 9rem 0 5rem;
      background: var(--bg-soft);
      border-bottom: 1px solid var(--border);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5vw, 3.8rem);
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .hero .role {
      font-size: 1.2rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .hero p.tagline {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.7;
      margin-bottom: 2rem;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.9rem 1.8rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      font-family: inherit;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      box-shadow: 0 4px 15px rgba(29, 78, 216, 0.3);
    }

    .btn-primary:hover {
      background: var(--accent-dark);
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--accent-light);
      border-color: var(--accent);
      color: var(--accent);
    }

    .hero-metrics {
      display: flex;
      gap: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
    }

    .metric-value {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
      line-height: 1;
      margin-bottom: 0.3rem;
    }

    .metric-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Foto */
    .hero-photo {
      position: relative;
      justify-self: center;
      max-width: 380px;
      width: 100%;
    }

    .photo-frame {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: var(--shadow);
      border: 4px solid var(--bg);
    }

    .photo-frame img {
      width: 100%;
      height: auto;
      object-fit: cover;
      aspect-ratio: 3/4;
      filter: grayscale(100%);
      transition: filter 0.3s;
    }

    .photo-frame:hover img {
      filter: grayscale(0%);
    }

    .photo-badge {
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 1);
      backdrop-filter: blur(10px);
      padding: 1rem;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .photo-badge strong {
      display: block;
      font-size: 0.95rem;
      color: #0f172a;
    }

    .photo-badge span {
      font-size: 0.85rem;
      color: #1e293b;
      font-weight: 600;
      display: block;
      margin-top: 2px;
    }

    /* ============ ABOUT ============ */
    .about-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 2rem;
    }

    .card {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: var(--shadow);
    }

    .bio p {
      color: var(--text-muted);
      margin-bottom: 1rem;
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .bio p:last-child {
      margin-bottom: 0;
    }

    .bio strong {
      color: var(--text);
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }

    .contact-info a {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-size: 0.95rem;
      color: var(--text-muted);
      transition: color 0.2s;
      font-weight: 500;
    }

    .contact-info a:hover {
      color: var(--accent);
    }

    .contact-info svg {
      color: var(--accent);
    }

    .soft-skills h3 {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
      color: var(--text);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .chip {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 600;
    }

    /* ============ SKILLS (Competencias) ============ */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .skill-card {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      transition: transform 0.2s;
      box-shadow: var(--shadow);
    }

    .skill-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent);
    }

    .skill-icon {
      width: 50px;
      height: 50px;
      background: var(--accent-light);
      color: var(--accent);
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .skill-card h4 {
      font-size: 1.15rem;
      margin-bottom: 0.8rem;
      color: var(--text);
    }

    .skill-card p {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ============ SECCIÓN EXTRA (TECH) ============ */
    .tech-extra {
      background: var(--bg-soft);
      border: 1px dashed var(--border);
      border-radius: 16px;
      padding: 2rem;
      margin-top: 3rem;
    }

    .tech-extra h4 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .tech-extra p {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .tech-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tech-chip {
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-weight: 600;
    }

    /* ============ EXPERIENCE ============ */
    .timeline {
      position: relative;
      padding-left: 2rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 6px;
      top: 10px;
      bottom: 10px;
      width: 2px;
      background: var(--border);
    }

    .exp-item {
      position: relative;
      margin-bottom: 2.5rem;
    }

    .exp-item::before {
      content: '';
      position: absolute;
      left: -2rem;
      top: 1.5rem;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--bg-soft);
      border: 3px solid var(--accent);
    }

    .exp-card {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.8rem;
      box-shadow: var(--shadow);
      transition: border-color 0.2s;
    }

    .exp-card:hover {
      border-color: var(--accent);
    }

    .exp-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }

    .exp-role {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
    }

    .exp-period {
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 700;
      background: var(--accent-light);
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
      white-space: nowrap;
    }

    .exp-company {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .exp-desc {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 1.2rem;
    }

    .exp-desc ul {
      padding-left: 1.2rem;
      list-style: disc;
    }

    .exp-desc li {
      margin-bottom: 0.5rem;
    }

    .exp-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .exp-tag {
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-weight: 600;
    }

    /* ============ EDUCACIÓN ============ */
    .edu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .edu-card {
      background: var(--bg-soft);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      box-shadow: var(--shadow);
    }

    .edu-card h4 {
      font-size: 1.05rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .edu-inst {
      font-size: 0.9rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 0.8rem;
    }

    .edu-card p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* ============ CONTACTO ============ */
    .contact-section {
      background: var(--accent);
      color: white;
      border-radius: 24px;
      padding: 4rem 2rem;
      text-align: center;
      margin-bottom: 4rem;
    }

    .contact-section h2 {
      font-size: 2.2rem;
      margin-bottom: 1rem;
      color: white;
    }

    .contact-section p {
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 2rem;
      opacity: 0.9;
    }

    .contact-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-white {
      background: white;
      color: var(--accent);
    }

    .btn-white:hover {
      background: #f1f5f9;
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: white;
    }

    /* ============ FOOTER ============ */
    footer {
      padding: 2rem 0;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
      .hero-grid, .about-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
      }

      .hero-photo {
        max-width: 320px;
        order: -1;
      }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        background: var(--bg-soft);
        padding: 2rem;
        border-bottom: 1px solid var(--border);
        clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
        transition: clip-path 0.3s;
      }

      .nav-links.open {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      }

      .menu-btn {
        display: block;
      }

      .nav-cta {
        display: none;
      }
    }
    </style>

    <!-- Script para forzar el modo oscuro -->
    <script is:inline>
      const temaGuardado = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', temaGuardado);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>