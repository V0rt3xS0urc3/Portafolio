      </div>
      
      <div class="card soft-skills">
        <h3>Habilidades y Competencias</h3>
        <div class="chips">
          <!-- Operaciones y Liderazgo -->
          <span class="chip">Liderazgo de Equipos (16+ personas)</span>
          <span class="chip">Control Físico y Documental de Carga</span>
          <span class="chip">Trazabilidad de Despachos</span>
          <span class="chip">Elaboración de Reportes y KPIs</span>
          
          <!-- Datos y ERP -->
          <span class="chip">SAP R/3 y S/4HANA (SD, MM, FI/CO)</span>
          <span class="chip">Power BI y SQL</span>
          <span class="chip">Excel Avanzado (Tablas dinámicas, BUSCARX)</span>
          
          <!-- Tecnología y Desarrollo -->
          <span class="chip">Desarrollo Web (HTML, CSS, JS, Astro)</span>
          <span class="chip">Programación FullStack Java</span>
          <span class="chip">Linux (Nivel Usuario)</span>
          <span class="chip">Resolución de Problemas</span>
