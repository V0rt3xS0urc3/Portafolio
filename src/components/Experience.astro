---
<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title">Experiencia Profesional</h2>
    <p class="section-subtitle">Más de 15 años construyendo operaciones más eficientes, trazables y con equipos sólidos.</p>

    <!-- Contenedor original con la clase timeline -->
    <div class="timeline" id="timeline">
      {EXPERIENCES.slice(0, 6).map((exp) => (
        <div class="exp-item">
          <div class="exp-card">
            <div class="exp-head">
              <div>
                <div class="exp-role">{exp.role}</div>
                <div class="exp-company">{exp.company}</div>
              </div>
              <span class="exp-period">{exp.period}</span>
            </div>
            <div class="exp-desc">
              <ul>
                {exp.bullets.map(b => <li>{b}</li>)}
              </ul>
            </div>
            <div class="exp-tags">
              {exp.tags.map(t => <span class="exp-tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div style="text-align: center; margin-top: 2rem;">
      <button id="btnVerMas" class="btn btn-secondary">
        ⬇️ Ver trayectoria completa ({EXPERIENCES.length - 6} roles anteriores)
      </button>
    </div>
  </div>
</section>

<script define:vars={{ EXPERIENCES }}>
  // @ts-nocheck
  const timeline = document.getElementById('timeline');
  const btnVerMas = document.getElementById('btnVerMas');
  let mostrandoTodo = false;

  // Función para crear el HTML de una tarjeta
  const crearTarjetaHTML = (exp) => `
    <div class="exp-item">
      <div class="exp-card">
        <div class="exp-head">
          <div>
            <div class="exp-role">${exp.role}</div>
            <div class="exp-company">${exp.company}</div>
          </div>
          <span class="exp-period">${exp.period}</span>
        </div>
        <div class="exp-desc">
          <ul>${exp.bullets.map(b => `<li>${b}</li>`).join('')}</ul>
        </div>
        <div class="exp-tags">
          ${exp.tags.map(t => `<span class="exp-tag">${t}</span>`).join('')}
        </div>
      </div>
    </div>
  `;

  btnVerMas?.addEventListener('click', () => {
    mostrandoTodo = !mostrandoTodo;

    if (mostrandoTodo) {
      // LÓGICA PARA EXPANDIR
      let htmlParaAgregar = '';

      // Agregamos las tarjetas de la 7 a la 9 (Fontova, Capital I & II, Federal)
      htmlParaAgregar += EXPERIENCES.slice(6, 9).map(crearTarjetaHTML).join('');

      // Agregamos el Título de Logística
      htmlParaAgregar += `<h3 style="text-align:center; margin: 2.5rem 0 1.5rem; color: var(--text-main); font-size: 1.2rem; font-weight: 700; border-top: 1px solid var(--border); padding-top: 1.5rem;">Experiencia Previa en Logística, Bodega y Operaciones (2004-2016)</h3>`;

      // Agregamos las tarjetas de la 10 en adelante (I-LINE hasta Peide)
      htmlParaAgregar += EXPERIENCES.slice(9).map(crearTarjetaHTML).join('');

      // Usamos insertAdjacentHTML para NO borrar el contenedor original (así conserva el CSS de Astro)
      timeline.insertAdjacentHTML('beforeend', htmlParaAgregar);
      
      btnVerMas.innerHTML = '⬆️ Ocultar experiencia antigua';

    } else {
      // LÓGICA PARA COLAPSAR
      // Borramos todas las tarjetas extra
      while (timeline.children.length > 6) {
        timeline.removeChild(timeline.lastChild);
      }
      
      btnVerMas.innerHTML = `⬇️ Ver trayectoria completa (${EXPERIENCES.length - 6} roles anteriores)`;
      
      // Hacemos scroll hacia arriba de la sección
      document.getElementById('experience')?.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>