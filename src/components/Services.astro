// src/components/Services.astro
---

<section id="servicios" class="section">
  <div class="container">
    <h2 class="section-title">Servicios de Desarrollo Web</h2>
    <p class="section-subtitle">
      Soluciones digitales a medida para profesionales independientes (contadores, abogados, corredores de propiedades), 
      administradores de condominios y empresas de logística. Tecnología moderna, ultrarrápida y sin costos de mantenimiento absurdos.
    </p>

    <div class="services-grid">
      <!-- Tarjeta 1: Profesionales Independientes -->
      <div class="service-card">
        <div class="service-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <h3 class="service-title">Marca Personal y Profesionales</h3>
        <p class="service-desc">
          Ideal para contadores, abogados, corredores de propiedades y administradores. Un sitio web que transmite confianza, muestra tus servicios claramente y permite que tus clientes te contacten directamente.
        </p>
        
        <div class="service-features">
          <span class="feature-tag">✅ Diseño profesional y serio</span>
          <span class="feature-tag">✅ Integración directa a WhatsApp</span>
          <span class="feature-tag">✅ Formulario de contacto al email</span>
          <span class="feature-tag">✅ Sin mensualidades de hosting</span>
        </div>

